# Credenciales de Supabase.
# Copia este archivo como ".env" en la raiz del proyecto y rellena los valores.
# NO subas el .env al repositorio (ya esta en .gitignore).

# 1) Project URL -> Supabase Dashboard > Project Settings > Data API
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# 2) Clave service_role -> Supabase Dashboard > Project Settings > API Keys
#    (no confundir con la clave publica "anon"/"publishable")
SUPABASE_KEY=TU-SERVICE-ROLE-KEY
